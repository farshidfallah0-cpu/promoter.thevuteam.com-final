# Production .env for the backend — copy this to /var/www/promoter/backend/.env on
# the server and fill in the values marked below. Never commit the real file.

# Optional — Google Sheets export integration. Leave SPREADSHEET_ID empty to
# disable it entirely (the backend degrades gracefully, nothing else breaks).
SERVICE_ACCOUNT_JSON_PATH=/secrets/sa.json
SPREADSHEET_ID=
SHEET_NAME=Sheet1

# REQUIRED — generate fresh values for production, do not reuse the ones from
# backend/.env on your dev machine:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=
ENCRYPTION_KEY=

# REQUIRED — must match the real public API domain so uploaded-image URLs the
# backend returns to the frontend are actually reachable.
PUBLIC_BASE_URL=https://api.promoter.thevuteam.com

# Optional — only needed if the Gemini voice-analysis feature is turned on.
GOOGLE_API_KEY=
