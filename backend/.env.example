SERVICE_ACCOUNT_JSON_PATH=/secrets/sa.json
SPREADSHEET_ID=your-google-spreadsheet-id
SHEET_NAME=Sheet1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt the promoter plain_password field stored for admin visibility.
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Base URL uploaded files (images/voice) are served from. Must match how this
# server is reached from the browser — e.g. http://localhost:8000 in dev,
# https://api.promoter.thevuteam.com in production.
PUBLIC_BASE_URL=http://localhost:8000

# Only needed if/when the Gemini voice-analysis feature is turned back on.
GOOGLE_API_KEY=
